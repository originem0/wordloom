[Unit]
Description=WordLoom
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/wordloom
EnvironmentFile=/home/ubuntu/wordloom/.env
Environment=NODE_ENV=production
Environment=PORT=3001
ExecStart=/usr/bin/node /home/ubuntu/wordloom/dist/server/index.js
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
