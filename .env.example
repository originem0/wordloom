# Authentication
AUTH_TOKEN=
AUTH_SECRET=

# Production: enter the full public origin, including scheme and any non-default port.
# Example: ALLOWED_ORIGINS=https://words.example.org
ALLOWED_ORIGINS=

# Compose behind host nginx: use the peer IP the app sees for that proxy.
# TRUSTED_PROXY_IPS=172.18.0.1

# Database URL
DATABASE_URL=file:data/app.db

# Optional: Port override
PORT=3001
